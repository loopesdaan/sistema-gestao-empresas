# ============================================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO (Render / Koyeb)
# ============================================================
ENVIRONMENT=production
PROJECT_NAME="Sistema de Gestão Empresarial"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Chave secreta de alta entropia para assinatura JWT
# Dica: gere com 'openssl rand -hex 32' ou deixe o Render gerar automaticamente
SECRET_KEY="SUA_CHAVE_SECRETA_JWT_SUPER_SEGURA_AQUI"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Banco de Dados Relacional Transacional ACID (CockroachDB Serverless, Neon.tech, Supabase)
# Opção 1: CockroachDB Serverless (50M RUs / 10GiB gratuitos - Compatível com PostgreSQL)
# Dica: use sslmode=require para compatibilidade total com containers em nuvem
DATABASE_URL="postgresql://usuario:senha@seu-cluster-1234.cockroachlabs.cloud:26257/defaultdb?sslmode=require"

# Opção 2: PostgreSQL Gerenciado Padrão (Neon.tech ou Supabase)
# DATABASE_URL="postgresql+psycopg2://usuario:senha@host:5432/nome_banco?sslmode=require"

# URL pública do Frontend hospedado na Netlify (para autorização no CORS)
FRONTEND_URL="https://seu-sistema-gestao.netlify.app"

# APIs de Pagamento (Mercado Pago desativado temporariamente em produção)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

